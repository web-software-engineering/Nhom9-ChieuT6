# Giao Hàng Nhanh (GHN) API Configuration
GHN_API_URL=https://dev-online-gateway.ghn.vn
GHN_SHOP_ID=your_shop_id
GHN_TOKEN=your_api_token
GHN_FROM_DISTRICT_ID=your_default_from_district_id

# Server Configuration
PORT=3000

# Database (Railway)
# Option 1: paste full Railway MySQL URL
MYSQL_URL=mysql://user:password@host:3306/railway

# Option 2: split fields (works for local and Railway)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=OnlineShoppingSystem
MYSQL_SSL=true

# OAuth / Auth callbacks
BACKEND_URL=https://nhom9-chieut6-backend.onrender.com
FRONTEND_URL=https://nhom9-chieu-t6.vercel.app
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://nhom9-chieut6-backend.onrender.com/api/auth/google/callback
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=https://nhom9-chieut6-backend.onrender.com/api/auth/facebook/callback