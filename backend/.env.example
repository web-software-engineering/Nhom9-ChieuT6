# Giao Hàng Nhanh (GHN) API Configuration
GHN_API_URL=https://dev-online-gateway.ghn.vn
GHN_SHOP_ID=your_shop_id
GHN_TOKEN=your_api_token
GHN_FROM_DISTRICT_ID=your_default_from_district_id
# Sandbox GHN hay giới hạn ~3 đơn/ngày: bật fallback trả mã GHNDEMO... để demo vẫn hoàn tất (mặc định bật nếu không khai báo). Đặt false để luôn báo lỗi GHN.
# GHN_DEMO_ORDER_FALLBACK=true

# ================= MoMo Payment Configuration =================
# Đăng ký / Đăng nhập MoMo Developer: https://developers.momo.vn/
# Môi trường test: MOMO_ENV=development | Môi trường production: MOMO_ENV=production
MOMO_ENV=development
MOMO_PARTNER_CODE=your_partner_code
MOMO_PARTNER_KEY=your_partner_key
MOMO_ACCESS_KEY=your_access_key
# Bật mock (không cần tài khoản thật)
MOMO_MOCK=false

# ================= VNPay Payment Configuration =================
# Đăng ký VNPay sandbox: https://sandbox.vnpayment.vn/devreg/
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
# URL VNPay redirect về sau thanh toán (phải trùng khi đăng ký sandbox / cấu hình merchant)
# Ví dụ: https://nhom9-chieut6-backend.onrender.com/api/vnpay/return
VNPAY_RETURN_URL=
# Bật mock (không cần tài khoản thật)
VNPAY_MOCK=false

# Server Configuration
PORT=3000

# Database (Railway)
# Option 1: paste full Railway MySQL URL
MYSQL_URL=mysql://user:password@host:3306/railway

# Option 2: split fields (works for local and Railway)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=OnlineShoppingSystem
MYSQL_SSL=true

# OAuth / Auth callbacks
BACKEND_URL=https://nhom9-chieut6-backend.onrender.com
FRONTEND_URL=https://nhom9-chieu-t6.vercel.app
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://nhom9-chieut6-backend.onrender.com/api/auth/google/callback
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=https://nhom9-chieut6-backend.onrender.com/api/auth/facebook/callback